{
  "compilerOptions": {
    "jsx": "react",
    "target": "ES6",
    "lib": ["dom", "ES2021"],
    "module": "CommonJS",
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "baseUrl": "src",
    "paths": {
      "*": ["*", "src/*", "src/store/*"]
    }
  },

  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", "webpack.config.ts", "styles.d.ts", "image.d.ts"]
}
